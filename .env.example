# --- Google Cloud Text-to-Speech --------------------------------------------
# Вариант 1 (рекомендуется, работает и на Vercel): ключ сервис-аккаунта целиком.
# Можно вставить сырой JSON в одну строку или его base64.
#   base64 -i key.json | tr -d '\n' | pbcopy
# tr нужен: на Linux/CI base64 переносит строки на 76 символах,
# а многострочное значение ломает парсинг .env.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Вариант 2 (только локально): путь к файлу ключа.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json

# Предохранитель: максимум тарифицируемых символов на одну генерацию.
# 120000 символов ≈ $1.92 на Neural2. Поднимайте осознанно.
TTS_MAX_CHARS=120000

# --- Доступ ------------------------------------------------------------------

# Ключ подписи сессионной куки. Без него вход отключён.
# Если не задан, берётся PAYLOAD_SECRET.
#   openssl rand -base64 32
AUTH_SECRET=

# --- Почта ------------------------------------------------------------------
# Без ключа коды печатаются в консоль сервера — удобно в разработке,
# в проде отсутствие ключа значит вход не работает.
RESEND_API_KEY=
EMAIL_FROM=Тренажёр синхрониста <noreply@example.com>
# Базовый адрес для ссылок-приглашений в письмах.
APP_URL=

# --- База и Payload ---------------------------------------------------------
# На Vercel подставляется интеграцией; принимаются также
# POSTGRES_URL и DATABASE_URL.
DATABASE_URI=
PAYLOAD_SECRET=

# --- Бюджет ------------------------------------------------------------------
# Жёсткий стоп: по достижении суммы генерация отклоняется с 402.
# Google на Text-to-Speech spend cap не поддерживает (только письма),
# так что это единственный настоящий предел.
#
# Общий потолок за всё время. Пусто — без ограничения.
TTS_BUDGET_USD=300
#
# Месячный потолок, сбрасывается первого числа. Пусто — без ограничения.
# Имеет смысл выставить вровень с бюджетом в Google Cloud.
# TTS_MONTHLY_LIMIT_USD=40
