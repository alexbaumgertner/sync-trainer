# --- Google Cloud Text-to-Speech --------------------------------------------
# Вариант 1 (рекомендуется, работает и на Vercel): ключ сервис-аккаунта целиком.
# Можно вставить сырой JSON в одну строку или его base64.
#   base64 -i key.json | tr -d '\n' | pbcopy
# tr нужен: на Linux/CI base64 переносит строки на 76 символах,
# а многострочное значение ломает парсинг .env.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Вариант 2 (только локально): путь к файлу ключа.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json

# Предохранитель: максимум тарифицируемых символов на одну генерацию.
# 120000 символов ≈ $1.92 на Neural2. Поднимайте осознанно.
TTS_MAX_CHARS=120000

# --- Доступ ------------------------------------------------------------------
# Общий пароль на генерацию. Без него генерация отключена:
# приложение публичное, а каждый запрос стоит денег.
APP_PASSWORD=

# Необязательно: отдельный ключ для подписи сессионной куки.
# Если не задан, выводится из APP_PASSWORD — тогда смена пароля
# автоматически разлогинивает всех.
# AUTH_SECRET=

# --- Бюджет ------------------------------------------------------------------
# Показывать прогресс «потрачено из N долларов». Пусто — просто сумма.
TTS_BUDGET_USD=300
