# --- Google Cloud Text-to-Speech --------------------------------------------
# Вариант 1 (рекомендуется, работает и на Vercel): ключ сервис-аккаунта целиком.
# Можно вставить сырой JSON в одну строку или его base64.
#   base64 -i key.json | pbcopy
GOOGLE_SERVICE_ACCOUNT_JSON=

# Вариант 2 (только локально): путь к файлу ключа.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json

# Предохранитель: максимум тарифицируемых символов на одну генерацию.
# 120000 символов ≈ $1.92 на Neural2. Поднимайте осознанно.
TTS_MAX_CHARS=120000
