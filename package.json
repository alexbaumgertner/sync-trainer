{
  "name": "sync-trainer",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "smoke": "node scripts/smoke.mjs",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate:create": "payload migrate:create --forceAcceptWarning",
    "migrate": "payload migrate",
    "db:up": "docker start sync-trainer-pg || docker run -d --name sync-trainer-pg -e POSTGRES_PASSWORD=devpass -e POSTGRES_USER=dev -e POSTGRES_DB=sync_trainer -p 5434:5432 postgres:17-alpine",
    "db:down": "docker stop sync-trainer-pg",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "invite": "node --import tsx scripts/invite.mjs",
    "migrate:usage": "node --import tsx scripts/migrate-usage.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@google-cloud/text-to-speech": "^7.1.0",
    "@google/genai": "^2.22.0",
    "@payloadcms/db-postgres": "^3.89.0",
    "@payloadcms/email-resend": "^3.89.0",
    "@payloadcms/next": "^3.89.0",
    "@payloadcms/richtext-lexical": "^3.89.0",
    "@payloadcms/storage-vercel-blob": "^3.89.0",
    "@vercel/blob": "^2.8.0",
    "graphql": "^16.14.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "next": "16.3.5",
    "payload": "^3.89.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/config": "^0.7.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "sass": "^1.104.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
